PORT=5000
NODE_ENV=development
# Une ou plusieurs origines front, séparées par des virgules
CLIENT_URL=http://localhost:3000,https://axxam-sw0k.onrender.com
# URL publique unique pour les liens e-mail (vérification)
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
JWT_SECRET=change-me-in-production

# E-mails (choisir Resend OU SMTP)
# 1) Crée un compte gratuit : https://resend.com
# 2) API Keys → Create → copie la clé re_...
# 3) Sans domaine perso, utilise SMTP_FROM=AXXAM <onboarding@resend.dev>
#    (tu ne peux envoyer qu'à l'e-mail de ton compte Resend au début)
RESEND_API_KEY=
SMTP_FROM=AXXAM <onboarding@resend.dev>
PUBLIC_APP_URL=http://localhost:3000

# Ou Gmail SMTP :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre@gmail.com
# SMTP_PASS=mot-de-passe-application
# SMTP_FROM=AXXAM <votre@gmail.com>
